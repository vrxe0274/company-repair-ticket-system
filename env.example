# ============================================================
# VRXE Repair Ticket System — Environment Variables
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# Never commit your real .env to Git (it's in .gitignore).
# All vars must start with VITE_ to be exposed to the app.
# ============================================================


# ── Supabase ────────────────────────────────────────────────
# From Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...


# ── Staff login passwords ───────────────────────────────────
# Login is one shared password per role (pick a role, enter its password).
# Passwords are verified SERVER-SIDE by the verify-login Edge Function, so they
# are Supabase SECRETS — NOT VITE_ vars — and never ship to the browser bundle.
# Roles: Admin (manages Terms, plus all Staff powers), Staff (ticket queue),
# Technician (repairs). Set them once, then redeploy verify-login:
#   supabase secrets set ADMIN_PASSWORD=choose-a-strong-admin-password
#   supabase secrets set STAFF_PASSWORD=choose-a-strong-staff-password
#   supabase secrets set TECH_PASSWORD=choose-a-strong-technician-password
#   supabase functions deploy verify-login --no-verify-jwt


# ── Destructive-action password ─────────────────────────────
# Required to flush the DB / delete tickets. Validated SERVER-SIDE by the
# admin-delete Edge Function, so it is NOT a VITE_ var (never shipped to the
# browser). Set it as a Supabase secret instead:
#   supabase secrets set ADMIN_DELETE_PASSWORD=choose-a-different-flush-password
#   supabase functions deploy admin-delete --no-verify-jwt
# Keep it different from the login passwords above.


# ── App URL ─────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your real Vercel URL, no trailing slash
# Used to build the public ticket-tracking links.
VITE_APP_URL=http://localhost:5173


# ── Web Push (VAPID) ────────────────────────────────────────
# Generate a key pair once:
#   npx web-push generate-vapid-keys
# The PUBLIC key goes here (safe to ship to the browser).
VITE_VAPID_PUBLIC_KEY=B...your-vapid-public-key...
# The PRIVATE key must NEVER be a VITE_ var. Set it as a
# Supabase Edge Function secret instead:
#   supabase secrets set VAPID_PUBLIC_KEY=<same public key>
#   supabase secrets set VAPID_PRIVATE_KEY=<private key>
#   supabase secrets set VAPID_SUBJECT=mailto:you@example.com
#   supabase functions deploy send-push --no-verify-jwt
# Also run push-setup.sql in the Supabase SQL Editor.

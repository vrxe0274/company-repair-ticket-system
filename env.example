# ============================================================
# VRXE Repair Ticket System — Environment Variables
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# Never commit your real .env to Git (it's in .gitignore).
# All vars must start with VITE_ to be exposed to the app.
# ============================================================


# ── Supabase ────────────────────────────────────────────────
# From Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...


# ── Staff login passwords ───────────────────────────────────
# Admin signs in with VITE_DASHBOARD_PASSWORD
# Technician signs in with VITE_TECH_PASSWORD
# Use two different, strong passwords.
VITE_DASHBOARD_PASSWORD=choose-a-strong-admin-login-password
VITE_TECH_PASSWORD=choose-a-strong-technician-login-password


# ── Destructive-action password ─────────────────────────────
# Separate password required to flush / reset the database.
# Keep this different from the login passwords above.
VITE_ADMIN_PASSWORD=choose-a-different-flush-password


# ── App URL ─────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your real Vercel URL, no trailing slash
# Used to build the public ticket-tracking links.
VITE_APP_URL=http://localhost:5173
